<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect /public/index.php to /
    RewriteCond %{THE_REQUEST} /public/index\.php [NC]
    RewriteRule ^public/index\.php(.*)$ $1 [L,R=301]

    # If the file exists in /public, serve it from there
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # If it's not a real file or directory, send to public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
