<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # 1. Kuelekeza maombi ya folder root kwenda public/index.php
    RewriteRule ^$ public/index.php [L]

    # 2. Ikiwa faili lipo ndani ya folda la public, litoe huko moja kwa moja (kwa ajili ya CSS, JS, Images)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 3. Kuelekeza maombi yote ya kurasa (routes) kwenda public/index.php bila kubadilisha URL
    # Hii inatatua tatizo la 404 kwenye /contact, /mission, nk.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
